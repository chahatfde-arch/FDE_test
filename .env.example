# Copy to .env and fill in. Never commit .env.

# Database. Default is a local SQLite file so everything runs in Colab.
# For SQL Server in Docker (infra/docker-compose.yml), use:
# DATABASE_URL=mssql+pyodbc://sa:YourStrong!Passw0rd@localhost:1433/creditlens?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATABASE_URL=sqlite:///creditlens.db

# Used from milestone 3 onward
GEMINI_API_KEY=
GROQ_API_KEY=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
